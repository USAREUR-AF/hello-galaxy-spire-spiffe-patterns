# hello-spire — goatnet runner config. Copy to goatnet/config.env and fill in.
#
# This is the PARTNER (pod) side. It runs the pod's OWN SPIRE, mints an X.509-SVID,
# and publishes/subscribes to a goatnet's Zenoh router over the NetBird mesh, driven
# by this file.
#
# PREREQS (one-time, done by the goatnet's operator — see docs/goatnet-onboarding.md):
#   1. This host is enrolled as a NetBird peer of the goatnet (so it can reach the router).
#   2. The operator declared this pod's trust domain in the `spire` role's
#      spire_federates_with, so the router trusts pod-issued certs.
#   3. The operator granted POD_CN write on your namespace in the Zenoh ACL.
#   4. You have the router's CA bundle.

# The pod's own SPIRE trust domain. Yours to choose; must match what the operator
# federated. Example: spiffe://acme-sensors.pod
POD_TRUST_DOMAIN="spiffe://CHANGE-ME.pod"

# The goatnet's Zenoh router, reachable over the NetBird mesh (mesh IP : 7447).
ROUTER_ENDPOINT="tls/CHANGE-ME-router-mesh-ip:7447"

# The SVID's Subject CN — must equal the ACL subject the operator granted you.
POD_CN="CHANGE-ME-acl-subject"

# Path to the router's CA bundle (verifies the router's server cert on connect).
# Relative to repo root or absolute.
ROUTER_CA="goatnet/router-ca.pem"

# The key-expression you publish/subscribe under (must be inside your granted namespace).
POD_KEY="CHANGE-ME/hello"
